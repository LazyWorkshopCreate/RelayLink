{
  "schemaVersion": 1,
  "clientId": "inspection-target",
  "displayName": "可审计目标示例",
  "enabled": true,
  "secret": "REPLACE_WITH_UNIQUE_32_RANDOM_BYTES_BASE64",
  "maxConnections": 20,
  "maxPendingConnections": 4,
  "channels": [
    {
      "channelId": "ssh-jump",
      "displayName": "SSH 跳板",
      "enabled": true,
      "listenAddress": "127.0.0.1",
      "listenPort": 22022,
      "targetHost": "127.0.0.1",
      "targetPort": 22,
      "maxConnections": 4,
      "targetConnectTimeoutSeconds": 10,
      "transportProtocol": "tcp",
      "inspectionMode": "server-jump",
      "tags": [
        "app:ssh"
      ],
      "inspection": {
        "approvalTimeoutSeconds": 60,
        "ssh": {
          "targetHostKeySha256": "SHA256:AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA",
          "allowShell": true,
          "allowExec": true,
          "allowSubsystem": true,
          "allowTcpForwarding": false,
          "allowAgentForwarding": false,
          "allowX11Forwarding": false,
          "deniedCommandPrefixes": [
            "reboot",
            "shutdown"
          ]
        }
      }
    },
    {
      "channelId": "http-peer",
      "displayName": "HTTP 可视互访",
      "enabled": true,
      "listenAddress": "127.0.0.1",
      "listenPort": 22080,
      "targetHost": "127.0.0.1",
      "targetPort": 8080,
      "maxConnections": 8,
      "targetConnectTimeoutSeconds": 10,
      "transportProtocol": "tcp",
      "authorizedClientsOnly": true,
      "endToEndEncryptionEnabled": true,
      "accessSecret": "REPLACE_WITH_UNIQUE_32_RANDOM_BYTES_BASE64",
      "inspectionMode": "server-peer",
      "tags": [
        "app:http"
      ],
      "inspection": {
        "approvalTimeoutSeconds": 60,
        "approveUnsafeMethods": true,
        "rules": [
          {
            "methods": [
              "GET",
              "HEAD"
            ],
            "pathPrefix": "/",
            "action": "allow"
          }
        ]
      }
    }
  ]
}
