<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <AssemblyName>RelayLink.Server</AssemblyName>
    <RootNamespace>RelayLink.Server</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="RelayLink.UnitTests" />
    <Content Include="admin-security.txt" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" Link="wwwroot/admin-security.txt" TargetPath="wwwroot/admin-security.txt" />
  </ItemGroup>
  <ItemGroup>
    <!-- Local test outputs must never become Web SDK publish content. -->
    <Content Remove="artifacts/**" />
    <None Remove="artifacts/**" />
    <ProjectReference Include="../RelayLink.Protocol/RelayLink.Protocol.csproj" />
    <ProjectReference Include="../RelayLink.Transport/RelayLink.Transport.csproj" />
    <ProjectReference Include="../RelayLink.Logging/RelayLink.Logging.csproj" />
    <PackageReference Include="Microsoft.Extensions.Hosting.WindowsServices" Version="10.0.2" />
    <PackageReference Include="Microsoft.Data.Sqlite.Core" Version="10.0.12" />
    <PackageReference Include="SQLitePCLRaw.provider.e_sqlite3" Version="2.1.12" />
    <PackageReference Include="SQLitePCLRaw.provider.sqlite3" Version="2.1.12" />
    <PackageReference Include="SQLitePCLRaw.lib.e_sqlite3" Version="2.1.12" Condition="'$(RuntimeIdentifier)' != 'linux-x64'" />
  </ItemGroup>
  <Target Name="RemoveBundledSqliteNativeLibraryForLinux"
          AfterTargets="Publish"
          Condition="'$(RuntimeIdentifier)' == 'linux-x64'">
    <Delete Files="$(PublishDir)libe_sqlite3.so" />
  </Target>
  <Target Name="BuildAdminWeb" BeforeTargets="Build;Publish">
    <Exec Condition="'$(SkipAdminWebBuild)' != 'true'" Command="pnpm --dir &quot;$(MSBuildProjectDirectory)/../RelayLink.AdminWeb&quot; build" />
  </Target>
  <Target Name="CopyAdminWebToBuild" AfterTargets="Build" DependsOnTargets="BuildAdminWeb">
    <ItemGroup>
      <AdminWebFile Include="$(MSBuildProjectDirectory)/../RelayLink.AdminWeb/dist/**/*" />
    </ItemGroup>
    <Copy SourceFiles="@(AdminWebFile)" DestinationFiles="@(AdminWebFile->'$(TargetDir)wwwroot/%(RecursiveDir)%(Filename)%(Extension)')" />
  </Target>
  <Target Name="CopyAdminSecurityProbeToBuild" AfterTargets="CopyAdminWebToBuild">
    <Copy SourceFiles="$(MSBuildProjectDirectory)/admin-security.txt" DestinationFolder="$(TargetDir)wwwroot" SkipUnchangedFiles="true" />
  </Target>
  <Target Name="CopyAdminSecurityProbeToPublish" AfterTargets="CopyAdminWebToPublish">
    <Copy SourceFiles="$(MSBuildProjectDirectory)/admin-security.txt" DestinationFolder="$(PublishDir)wwwroot" SkipUnchangedFiles="true" />
  </Target>
  <Target Name="CopyAdminWebToPublish" AfterTargets="Publish" DependsOnTargets="BuildAdminWeb">
    <ItemGroup>
      <AdminWebPublishFile Include="$(MSBuildProjectDirectory)/../RelayLink.AdminWeb/dist/**/*" />
    </ItemGroup>
    <Copy SourceFiles="@(AdminWebPublishFile)" DestinationFiles="@(AdminWebPublishFile->'$(PublishDir)wwwroot/%(RecursiveDir)%(Filename)%(Extension)')" />
  </Target>
</Project>
