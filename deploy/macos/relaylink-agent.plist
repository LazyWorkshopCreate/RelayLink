<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.relaylink.agent</string>
  <key>ProgramArguments</key>
  <array>
    <string>/Library/RelayLink/Agent/RelayLink.Agent</string>
    <string>--config</string>
    <string>/Library/Application Support/RelayLink/Agent/agent.json</string>
  </array>
  <key>WorkingDirectory</key>
  <string>/Library/RelayLink/Agent</string>
  <key>UserName</key>
  <string>_relaylink-agent</string>
  <key>GroupName</key>
  <string>_relaylink-agent</string>
  <key>RunAtLoad</key>
  <true/>
  <key>KeepAlive</key>
  <dict>
    <key>SuccessfulExit</key>
    <false/>
  </dict>
  <key>ThrottleInterval</key>
  <integer>10</integer>
  <key>ProcessType</key>
  <string>Background</string>
  <key>Umask</key>
  <integer>63</integer>
  <key>SoftResourceLimits</key>
  <dict>
    <key>NumberOfFiles</key>
    <integer>16384</integer>
  </dict>
  <key>HardResourceLimits</key>
  <dict>
    <key>NumberOfFiles</key>
    <integer>32768</integer>
  </dict>
  <key>StandardOutPath</key>
  <string>/Library/Logs/RelayLink/agent.stdout.log</string>
  <key>StandardErrorPath</key>
  <string>/Library/Logs/RelayLink/agent.stderr.log</string>
</dict>
</plist>
