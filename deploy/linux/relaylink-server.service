[Unit]
Description=RelayLink TCP Tunnel Server
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=relaylink
Group=relaylink
UMask=0077
WorkingDirectory=/opt/relaylink/server
ExecStart=/opt/relaylink/server/RelayLink.Server --config /etc/relaylink/server.json --log-directory /var/lib/relaylink/logs
Restart=on-failure
RestartSec=5
TimeoutStopSec=40
LimitNOFILE=16384
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/etc/relaylink /var/lib/relaylink
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
LockPersonality=true
CapabilityBoundingSet=
AmbientCapabilities=

[Install]
WantedBy=multi-user.target
